# SQLAlchemy database URL (matches the published compose port).
DATABASE_URL=postgresql+psycopg2://app:app@127.0.0.1:5435/app
# Keycloak server URL; in production this is an externally managed Keycloak.
# Must be the URL the BROWSER uses to reach Keycloak: the token's issuer
# claim is stamped from the browser-side authorize request, so it must
# match or every login is rejected.
KEYCLOAK_URL=http://localhost:8080
# Keycloak realm this app authenticates against.
KEYCLOAK_REALM=master
# Keycloak client ID registered for this app.
KEYCLOAK_CLIENT_ID=syzygy
# Keycloak client secret (empty for a public client).
KEYCLOAK_CLIENT_SECRET=
# Dev-only local login (see README, "Authentication (Keycloak)"): when
# set, this static token signs the browser in as the local dev admin
# WITHOUT Keycloak, and /auth/redirect issues the session cookie
# directly. Leave EMPTY in production.
#DEV_AUTH_TOKEN=

# --- Production (docker-compose.yml alone) ---
# Host directory for the bundled db's data (bind mount). Set this on
# the prod host (and chown -R 999:999 the directory first); when unset
# the data goes to the named volume db_data. NOT used by the dev stack
# — leave unset for local development.
#PG_DATA_DIR=/var/lib/postgres/syzygy/app
# Strong password for the bundled db; it must match DATABASE_URL (also
# set POSTGRES_USER / POSTGRES_DB if you change them).
#POSTGRES_PASSWORD=
#DATABASE_URL=postgresql+psycopg2://syzygy:PASSWORD@db:5432/syzygy

# --- Production: SMILE listener (bundled in docker-compose.yml) ---
# NATS server of the org-run SMILE gateway (JetStream). REQUIRED when the
# smile-listener service is part of the prod stack.
#NATS_URL=nats://prod-nats-host:4222
# Shared X-NATS-Token secret between the app (NATS_INGEST_TOKEN) and the
# listener; compose feeds this ONE variable to both sides. Generate a long
# random value; never commit it. Unset on the app side = ingest endpoint
# disabled (fail-closed).
#NATS_INGEST_TOKEN=
*** Outbox flusher: off by default; set truthy to arm the listener-side
# cohort-result republisher. Subject/durable names default to the agreed
# docs/nats_topics.md values — override only by agreement.
#COHORT_PUBLISH_ENABLED=
