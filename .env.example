# Syzygy development environment configuration
#
# Copy to .env and fill in values:  cp .env.example .env
#
# This is the LOCAL DEVELOPMENT template — dev Postgres, Keycloak-free
# login, and the dev NATS token. Every variable maps 1:1 to a Settings
# field in syzygy/database.py (the compose-only variables in the
# Production section are exceptions, noted as such). Do NOT use these
# values in staging or production — see staging.env.example for those
# environments.

# --- Database ---
# SQLAlchemy database URL (matches the published compose port). The dev
# default points at the dev Postgres that docker-compose.dev.yml publishes
# on 127.0.0.1:5435 (user/pass `app`). For a zero-Docker seed-only session,
# use SQLite instead:
#   DATABASE_URL=sqlite:///./syzygy.db
DATABASE_URL=postgresql+psycopg2://app:app@127.0.0.1:5435/app

# --- Pairing ---
# Optional default pairing logic applied automatically when samples are
# created (one of: ACCESS, ARGOS, TEMPO, DMP, HARMONY). ARGOS is the
# recommended default for the dummy-data quickstart; leave unset to let the
# app decide.
DEFAULT_PAIRING_LOGIC_NAME=ARGOS
# Optional read-only Beagle DB (a restored local dump — local data, never
# in production) used ONLY to resolve the DMP pair file's bam_exists column
# (docs/dmp_reference_alignment.md section f). Unset or unreachable ->
# bam_exists 0. Not needed for the seed/mock quickstart.
#BEAGLE_DATABASE_URL=postgresql+psycopg2://syzygy:syzygy_dev_password@localhost:5432/syzygy

# --- Auth ---
# Keycloak server URL; in production this is an externally managed Keycloak.
# Must be the URL the BROWSER uses to reach Keycloak: the token's issuer
# claim is stamped from the browser-side authorize request, so it must
# match or every login is rejected.
KEYCLOAK_URL=http://localhost:8080
# Keycloak realm this app authenticates against.
KEYCLOAK_REALM=master
# Keycloak client ID registered for this app.
KEYCLOAK_CLIENT_ID=syzygy
# Keycloak client secret (empty for a public client).
KEYCLOAK_CLIENT_SECRET=
# Dev-only local login (see README, "Keycloak-free local login"): when set,
# this static token signs the browser in as the local dev admin WITHOUT
# Keycloak, and /auth/redirect issues the session cookie directly.
# Leave EMPTY in production.
# *** NEVER set DEV_AUTH_TOKEN in production *** — it bypasses SSO.
# Example dev value (a shared local secret — change it per machine):
DEV_AUTH_TOKEN=dev-syzygy-token
# The synthetic identity the dev token maps to (sub dev-admin; shown in the
# UI and logs). Matches the Settings default; override per team if desired.
DEV_AUTH_EMAIL=dev-admin@syzygy.local

# --- Logic gating ---
# Per-user pairing-logic entitlements, read from the access token while
# enabled (dark launch: false = today's behavior, everyone gets the full
# logic set + admin; the claims are ignored). See docs/logic_gating_setup.md.
LOGIC_GATING_ENABLED=false
# Access-token claim holding a JSON list of exact pairing-logic names
# (e.g. ["ARGOS", "DMP"]); unknown names are ignored with a warning.
LOGIC_CLAIM_NAME=syzygy_logics
# Access-token claim holding the logic-admin flag (any truthy value).
LOGIC_ADMIN_CLAIM=syzygy_admin

# --- CRF output ---
# Directory for server-side CRF file writes. For local dev use
# ./crf_output_dev — the host directory that docker-compose.dev.yml binds
# to /app/crf_output_dev inside the container app.
CRF_OUTPUT_DIR=./crf_output_dev

# --- NATS ingest ---
# NATS server for the smile-listener. The production compose file declares
# NATS_URL as REQUIRED (${NATS_URL:?...}) and compose interpolates EACH FILE
# BEFORE merging overrides, so the layered dev stack still needs a value here
# even though docker-compose.dev.yml also sets nats://nats:4222 per-service.
# Without it, `docker compose -f docker-compose.yml -f docker-compose.dev.yml
# up` fails at parse time with "required variable NATS_URL is missing".
NATS_URL=nats://nats:4222
# Shared X-NATS-Token secret between the app (NATS_INGEST_TOKEN) and the
# listener; compose feeds this ONE variable to both sides. The dev value
# below matches docker-compose.dev.yml — if you change it, change the
# compose file too. Unset on the app side = ingest endpoint disabled
# (fail-closed). Generate a long random value for anything real; never
# commit it.
NATS_INGEST_TOKEN=dev-syzygy-nats-token
# Outbox flusher: off by default; set truthy to arm the listener-side
# cohort-result republisher. Subject/durable names default to the agreed
# docs/nats_topics.md values — override only by agreement.
#COHORT_PUBLISH_ENABLED=false
# NATS subject settings (see docs/nats_topics.md) default to the agreed
# MDB_STREAM names — the app dispatches on these, so uncomment to override:
#NATS_NEW_REQUEST_SUBJECT=MDB_STREAM.server.cpt-gateway.cmo-new-request
#NATS_REQUEST_UPDATE_SUBJECT=MDB_STREAM.server.cpt-gateway.cmo-request-update
#NATS_SAMPLE_UPDATE_SUBJECT=MDB_STREAM.server.cpt-gateway.cmo-sample-update
#NATS_DMP_SAMPLE_SUBJECT=MDB_STREAM.server.dmp-gateway.dmp-sample
#NATS_COHORT_VALIDATE_SUBJECT=MDB_STREAM.syzygy.inbound.tempo-cohort-validate
#NATS_COHORT_RESULT_SUBJECT=MDB_STREAM.server.syzygy.outbound.tempo-cohort-result

# --- Production (docker-compose.yml alone) ---
# Host directory for the bundled db's data (bind mount). Set this on
# the prod host (and chown -R 999:999 the directory first); when unset
# the data goes to the named volume db_data. NOT used by the dev stack
# — leave unset for local development. (Compose-only, not a Settings field.)
#PG_DATA_DIR=/var/lib/postgres/syzygy/app
# Strong password for the bundled db; it must match DATABASE_URL (also
# set POSTGRES_USER / POSTGRES_DB if you change them).
# (Compose-only, not a Settings field.)
#POSTGRES_PASSWORD=
#DATABASE_URL=postgresql+psycopg2://syzygy:PASSWORD@db:5432/syzygy
# NATS server of the org-run SMILE gateway (JetStream). REQUIRED when the
# smile-listener service is part of the prod stack. (Compose/listener-only,
# not a Settings field.)
#NATS_URL=nats://prod-nats-host:4222
