# Staging deployment config for docker-compose.yml (production base).
#
# Copy to `.env` in this directory on the staging host (compose loads it
# automatically), or export these in the shell — the shell wins over
# `.env`. NEVER commit real secrets; this file holds placeholders only.
#
# Staging branch specifics:
#   - the app is published on HOST port 1337 (container still serves 8000);
#   - the smile-listener uses TEST durables so it can never share beagle's
#     prod durables (`syzygy` / `syzygy-tmp`);
#   - until the gateway team provisions staging-scoped subjects, bring the
#     stack up WITHOUT the listener:  docker compose up -d db app
#     A fresh durable pointed at the prod filter subjects below would
#     replay the stream's retained history into the staging DB.

# --- Database (bundled `db` service) ---
POSTGRES_USER=syzygy
POSTGRES_PASSWORD=CHANGE..._DB
POSTGRES_DB=syzygy
DATABASE_URL=postgresql+psycopg2://syzygy:***@db:5432/syzygy
# Host data dir for the bind mount; `chown -R 999:999` it first on a
# Linux host. Unset -> named volume db_data.
#PG_DATA_DIR=/var/lib/postgres/syzygy/app

# --- Keycloak (org-managed, external) ---
# MUST be the exact URL the browser uses (token issuer claim); staging
# serves the app on :1337, so register redirect URI
# http://<staging-host>:1337/auth/callback and web origin
# http://<staging-host>:1337 in the Keycloak client.
KEYCLOAK_URL=http://staging.example.org:1337
KEYCLOAK_REALM=CHANGE_ME
KEYCLOAK_CLIENT_ID=syzygy
KEYCLOAK_CLIENT_SECRET=***
# Dev-only static-token backdoor — MUST stay empty on staging.
DEV_AUTH_TOKEN=

*** --- SMILE listener / NATS (org SMILE gateway JetStream) ---
NATS_URL=nats://CHANGE_ME_prod_nats_host:4222
# Shared X-NATS-Token secret between app and listener (one variable feeds
# both sides). Generate a long random value: openssl rand -hex 32
NATS_INGEST_TOKEN=***
# TEST durables (staging) — never reuse the prod durables syzygy /
# syzygy-tmp, or staging load-balances deliveries with beagle.
NATS_DURABLE=syzygy-staging
NATS_TEMPO_DURABLE=syzygy-tmp-staging
# Filter subjects below are the PROD defaults. Keep the listener DOWN
# until the gateway team provisions staging-scoped subjects, then
# override these to point ONLY at those (docs/nats_topics.md).
NATS_FILTER_SUBJECT=MDB_STREAM.server.cpt-gateway.>
NATS_TEMPO_FILTER_SUBJECT=MDB_STREAM.syzygy.inbound.>
NATS_RESULT_SUBJECT=MDB_STREAM.server.syzygy.outbound.tempo-cohort-result
# Outbox flusher stays off until the cohort-result flow is agreed.
COHORT_PUBLISH_ENABLED=false
